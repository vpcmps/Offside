<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Offside.OpenTelemetry</RootNamespace>
    <AssemblyName>Offside.OpenTelemetry</AssemblyName>
    <PackageId>Offside.OpenTelemetry</PackageId>
    <Description>OpenTelemetry telemetry for Offside domain errors, for hosts using Azure.Monitor.OpenTelemetry or any OTLP exporter. Catch it before the whistle.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);opentelemetry;telemetry;observability;azure-monitor;logging;metrics;tracing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
    <ProjectReference Include="..\Offside\Offside.csproj" />
  </ItemGroup>
</Project>
