<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Offside.MediatR</RootNamespace>
    <AssemblyName>Offside.MediatR</AssemblyName>
    <PackageId>Offside.MediatR</PackageId>
    <Description>MediatR domain notification integration for Offside Results. Catch it before the whistle.</Description>
    <PackageTags>$(PackageTags);mediatr;notifications;cqrs</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" Version="[12.0.1,15.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <ProjectReference Include="..\Offside\Offside.csproj" />
  </ItemGroup>
</Project>
